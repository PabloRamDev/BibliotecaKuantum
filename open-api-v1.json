{
  "openapi": "3.1.1",
  "info": {
    "title": "Biblioteca Kuantum API",
    "description": "API REST de Biblioteca Kuantum, (prueba técnica octubre 2026) por Pablo Ramírez. \nProporciona endpoints para crear, obtener, actualizar y eliminar documentos, \nademás de un endpoint de búsqueda dedicado para consultar el catálogo de documentos.\n\nPermite:\n- Registrar documentos con su índice de páginas.\n- Consultar un documento por su identificador.\n- Buscar documentos por código de serie, código de publicación o texto libre, con resultados paginados.\n- Actualizar y eliminar documentos existentes.\n\nPrimeros pasos\n 1. Agregar la variable apiKey con una API key registrada en el archivo .ENV en el botón Authorize.\n 3. Se puede probar cada endpoint. Se incluye ejemplos guardados que muestran respuestas exitosas y de error.",
    "contact": {
      "name": "Pablo Ramírez",
      "email": "pabloram.dev@gmail.com"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080/"
    }
  ],
  "paths": {
    "/api/Documents": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Crear documento",
        "description": "Registra un nuevo documento en la biblioteca y devuelve el documento creado con su identificador asignado. La cabecera Location apunta al recurso creado (GET api/Documents/{id}).",
        "requestBody": {
          "description": "Datos del documento a crear.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDocument"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDocument"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDocument"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Documento creado correctamente. Devuelve el documento con su Id.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Los datos enviados no son válidos o el documento no pudo crearse.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Documents/{id}": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Obtener documento por Id",
        "description": "Devuelve un único documento a partir de su identificador numérico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador numérico del documento.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Documento encontrado.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe un documento con el Id indicado.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Documents"
        ],
        "summary": "Actualizar documento",
        "description": "Actualiza los datos de un documento existente y devuelve el documento actualizado.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador numérico del documento a actualizar.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Nuevos datos del documento.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDocument"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDocument"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDocument"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Documento actualizado correctamente.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Los datos enviados no son válidos o el documento no existe.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Eliminar documento",
        "description": "Elimina un documento de la biblioteca a partir de su identificador.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador numérico del documento a eliminar.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Documento eliminado correctamente.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "El documento no pudo eliminarse (por ejemplo, porque no existe).",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Documents/search": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Buscar documentos",
        "description": "Busca documentos aplicando filtros opcionales y devuelve los resultados paginados. Todos los filtros son opcionales y se pueden combinar; si no se envía ninguno, se devuelven todos los documentos de forma paginada.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Filtra por identificador exacto del documento.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "serialCode",
            "in": "query",
            "description": "Filtra por código de serie del documento.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publicationCode",
            "in": "query",
            "description": "Filtra por código de publicación del documento.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchText",
            "in": "query",
            "description": "Texto libre para buscar coincidencias en los datos del documento.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Número de página a devolver, comenzando en 1. Valor por defecto: 1.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Cantidad de documentos por página. Valor por defecto: 10.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado paginado con los documentos que cumplen los filtros.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfDocumentResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfDocumentResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfDocumentResponse"
                }
              }
            }
          },
          "404": {
            "description": "La búsqueda no pudo realizarse o no devolvió resultados."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDocument": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "Nombre o título del documento.",
            "example": "Introducción a la computación cuántica"
          },
          "description": {
            "maxLength": 1000,
            "type": [
              "null",
              "string"
            ],
            "description": "Descripción o resumen del contenido del documento.",
            "example": "Texto introductorio sobre qubits, superposición y entrelazamiento."
          },
          "authorFullName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Nombre completo del autor del documento.",
            "example": "María González"
          },
          "authorEmail": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "Correo electrónico de contacto del autor.",
            "format": "email",
            "example": "maria.gonzalez@example.com"
          },
          "serialCode": {
            "maxLength": 16,
            "minLength": 1,
            "type": "string",
            "description": "Código de serie único del documento.",
            "example": "SN-2026-000123"
          },
          "publicationCode": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Código de publicación del documento.",
            "example": "PUB-2026-0042"
          },
          "documentPages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateDocumentPageIndex"
            },
            "description": "Índice de páginas del documento. Se require agregar una página o más"
          }
        },
        "description": "Datos necesarios para registrar un nuevo documento en la biblioteca."
      },
      "CreateDocumentPageIndex": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Nombre de la entrada del índice (capítulo, sección, etc.).",
            "example": "Capítulo 1: Qubits"
          },
          "page": {
            "minimum": 1,
            "type": "integer",
            "description": "Número de página donde comienza la entrada.",
            "format": "int32",
            "example": 1
          }
        },
        "description": "Entrada del índice de páginas de un documento (al crear o actualizar)."
      },
      "DocumentPageIndexResponse": {
        "type": "object",
        "properties": {
          "id": {
            "minimum": 1,
            "type": "integer",
            "description": "Identificador único de la entrada del índice.",
            "format": "int32",
            "example": 1
          },
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Nombre de la entrada del índice (capítulo, sección, etc.).",
            "example": "Capítulo 1: Qubits"
          },
          "page": {
            "minimum": 1,
            "type": "integer",
            "description": "Número de página donde comienza la entrada.",
            "format": "int32",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "description": "Fecha y hora de creación del registro (ISO 8601 con zona horaria).",
            "format": "date-time",
            "example": "2026-10-31T18:00:00-03:00"
          }
        },
        "description": "Entrada registrada del índice de páginas de un documento."
      },
      "DocumentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "minimum": 1,
            "type": "integer",
            "description": "Identificador único del documento.",
            "format": "int32",
            "example": 1
          },
          "name": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "Nombre o título del documento.",
            "example": "Introducción a la computación cuántica"
          },
          "description": {
            "maxLength": 1000,
            "type": [
              "null",
              "string"
            ],
            "description": "Descripción o resumen del contenido del documento.",
            "example": "Texto introductorio sobre qubits, superposición y entrelazamiento."
          },
          "authorFullName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Nombre completo del autor del documento.",
            "example": "María González"
          },
          "authorEmail": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "Correo electrónico de contacto del autor.",
            "format": "email",
            "example": "maria.gonzalez@example.com"
          },
          "serialCode": {
            "maxLength": 16,
            "minLength": 1,
            "type": "string",
            "description": "Código de serie único del documento.",
            "example": "SN-2026-000123"
          },
          "publicationCode": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Código de publicación del documento.",
            "example": "PUB-2026-0042"
          },
          "createdAt": {
            "type": "string",
            "description": "Fecha y hora de creación del registro (ISO 8601 con zona horaria).",
            "format": "date-time",
            "example": "2026-10-31T18:00:00-03:00"
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Fecha y hora de la última actualización (ISO 8601 con zona horaria). Es nulo si el documento nunca se ha modificado.",
            "format": "date-time",
            "example": "2026-10-31T18:00:00-03:00"
          },
          "documentPages": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/DocumentPageIndexResponse"
            },
            "description": "Índice de páginas del documento."
          }
        },
        "description": "Documento de la biblioteca con su índice de páginas."
      },
      "PagedResultOfDocumentResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentResponse"
            }
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateDocument": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "Nombre o título del documento.",
            "example": "Introducción a la computación cuántica"
          },
          "description": {
            "maxLength": 1000,
            "type": [
              "null",
              "string"
            ],
            "description": "Descripción o resumen del contenido del documento.",
            "example": "Texto introductorio sobre qubits, superposición y entrelazamiento."
          },
          "authorFullName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Nombre completo del autor del documento.",
            "example": "María González"
          },
          "authorEmail": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "Correo electrónico de contacto del autor.",
            "format": "email",
            "example": "maria.gonzalez@example.com"
          },
          "serialCode": {
            "maxLength": 16,
            "type": [
              "null",
              "string"
            ],
            "description": "Código de serie único del documento.",
            "example": "SN-2026-000123"
          },
          "publicationCode": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "Código de publicación del documento.",
            "example": "PUB-2026-0042"
          },
          "documentPages": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/CreateDocumentPageIndex"
            },
            "description": "Índice de páginas del documento."
          }
        },
        "description": "Datos para actualizar un documento existente."
      }
    },
    "securitySchemes": {
      "ApiKeyScheme": {
        "type": "apiKey",
        "description": "API key enviada en el header X-Api-Key",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "ApiKeyScheme": [ ]
    }
  ],
  "tags": [
    {
      "name": "Documents",
      "description": "Gestión de documentos de la biblioteca: alta, consulta, búsqueda paginada, actualización y eliminación."
    }
  ]
}